includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests
    tmpDir: storage/phpstan
    level: 6
    reportUnmatchedIgnoredErrors: false
